# =============================================================================
# Veylora - AI Autonomous Vulnerability Assessment Platform
# Environment configuration template. Copy to `backend/.env` and adjust.
# All values are overridable via real environment variables too.
# =============================================================================

# ---- Application ----
APP_NAME=AI Autonomous Vulnerability Assessment Platform
APP_VERSION=1.0.0
DEBUG=true

# ---- Database ----
# Use SQLite for local development (no install needed):
DATABASE_URL=sqlite:///./app.db
# Or PostgreSQL (used in docker-compose):
# DATABASE_URL=postgresql://apt:apt_password@localhost:5432/apt

# ---- Task queue (optional; falls back to in-process executor when unset) ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
TASK_EXECUTOR=local            # "local" | "celery"

# ---- Graph database (optional; falls back to NetworkX + SQLite) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# ---- Security ----
# PRODUCTION: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=CHANGE_ME_development_secret_not_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_TTL_MINUTES=10
OTP_LENGTH=6

# Development convenience: return the OTP in the API response so the
# signup/verify flow can be exercised WITHOUT a real SMTP server.
# Production deployments MUST set EMAIL_ENABLED=true and DEV_OTP_RETURN=false.
DEV_OTP_RETURN=true

# ---- Email (Gmail SMTP used for real OTP delivery) ----
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# For Gmail, use an App Password (https://support.google.com/accounts/answer/185833) - not your login password.
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Veylora <your.email@gmail.com>

# ---- AI analyst provider ----
# "rule" (heuristic, offline, always available) | "ollama" | "openai" | "local"
AI_PROVIDER=rule
AI_API_KEY=
# Ollama (optional):
AI_MODEL=llama3.2
AI_BASE_URL=http://localhost:11434

# ---- Validation ----
VALIDATION_DEFAULT_LEVEL=1
VALIDATION_REQUIRE_APPROVAL=true

# ---- Evidence ----
EVIDENCE_DIR=evidence_store

# ---- Scanning / adapters ----
# Comma-separated scanner adapters used for the vulnerability scan stage.
# "simulated-lab" uses a deterministic, safe, in-memory lab dataset (default for demos).
# "nmap" requires Nmap on PATH and network access to in-scope targets.
# "nuclei" requires Nuclei templates installed locally.
DEFAULT_SCAN_ADAPTERS=simulated-lab

# ---- Seed admin account (created automatically on first startup) ----
SEED_ADMIN_EMAIL=admin@secops.io
SEED_ADMIN_PASSWORD=Admin@12345

# ---- Rate limiting ----
RATE_LIMIT_MAX=120             # general requests per minute per client
RATE_LIMIT_WINDOW_SECONDS=60